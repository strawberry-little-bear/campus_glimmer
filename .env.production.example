# Copy this file to .env.production and replace every CHANGE_ME value.
# URLs must URL-encode special characters in passwords (for example @ becomes %40).
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_WITH_AT_LEAST_32_CHARS
DJANGO_ALLOWED_HOSTS=campus.example.edu,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://campus.example.edu
DJANGO_DATABASE_URL=postgresql://campus_glimmer:CHANGE_ME_URL_ENCODED@db:5432/campus_glimmer
DJANGO_CACHE_URL=redis://:CHANGE_ME_URL_ENCODED@redis:6379/1
DJANGO_CACHE_KEY_PREFIX=campus-glimmer-prod
DJANGO_CACHE_CONNECT_TIMEOUT=3
DJANGO_CACHE_SOCKET_TIMEOUT=3
DJANGO_STORAGE_BACKEND=s3
DJANGO_S3_BUCKET=campus-glimmer
DJANGO_S3_REGION=us-east-1
DJANGO_S3_ENDPOINT_URL=http://minio:9000
DJANGO_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
DJANGO_S3_ACCESS_KEY_ID=CHANGE_ME
DJANGO_S3_SECRET_ACCESS_KEY=CHANGE_ME
DJANGO_S3_ADDRESSING_STYLE=path
DJANGO_S3_QUERYSTRING_AUTH=1
DJANGO_S3_QUERYSTRING_EXPIRE=3600
DJANGO_S3_LOCATION=media

POSTGRES_DB=campus_glimmer
POSTGRES_USER=campus_glimmer
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=campus-glimmer
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEB_BIND=127.0.0.1:8000

BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# For an HTTPS deployment, turn these on after the proxy is verified.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@campus.example.edu
